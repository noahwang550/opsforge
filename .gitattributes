# Normalize all text files to LF line endings on checkout regardless of
# platform core.autocrlf setting. Without this, Windows clones get CRLF,
# which breaks CRLF-sensitive regex tests (e.g. validate.test.mjs T2).
* text=auto eol=lf

# Explicit LF for all source/config/doc files
*.mjs  text eol=lf
*.js   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

# Binary files — never normalize
*.png  binary
*.jpg  binary
*.pdf  binary
