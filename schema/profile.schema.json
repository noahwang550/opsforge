{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/profile.schema.json",
  "title": "OpsForge installation profile (§20 v7, Phase 2.3)",
  "description": "Composable custom installation profile. additionalProperties:false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "display_name", "display_name_zh"],
  "properties": {
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "display_name_zh": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}\\.[a-z][a-z0-9-]{2,30}@.+" }
    },
    "workflows": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bundles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}\\.[a-z][a-z0-9-]{2,30}@.+" }
    }
  }
}
