{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/platform.schema.json",
  "title": "OpsForge platform declaration (v9 §22.2)",
  "description": "9 个正交能力点，每平台声明 supported/fallback。",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "display_name", "display_name_zh", "capability_points", "locale", "compliance_tags"],
  "properties": {
    "platform": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "display_name_zh": { "type": "string", "minLength": 1 },
    "capability_points": {
      "type": "object",
      "required": ["prompt_exec", "agent_file", "skill_file", "slash_command", "mcp_config", "workflow_orchestration", "config_dir_writable", "kb_mount", "feedback_hook"],
      "additionalProperties": false,
      "properties": {
        "prompt_exec": { "$ref": "#/$defs/capabilityPoint" },
        "agent_file": { "$ref": "#/$defs/capabilityPoint" },
        "skill_file": { "$ref": "#/$defs/capabilityPoint" },
        "slash_command": { "$ref": "#/$defs/capabilityPoint" },
        "mcp_config": { "$ref": "#/$defs/capabilityPoint" },
        "workflow_orchestration": { "$ref": "#/$defs/capabilityPoint" },
        "config_dir_writable": { "$ref": "#/$defs/capabilityPoint" },
        "kb_mount": { "$ref": "#/$defs/capabilityPoint" },
        "feedback_hook": { "$ref": "#/$defs/capabilityPoint" }
      }
    },
    "locale": { "type": "string" },
    "compliance_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verified_by": { "type": "string" },
    "model_registration": { "type": "string" }
  },
  "$defs": {
    "capabilityPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": { "type": "boolean" },
        "mode": { "type": "string" },
        "endpoint_env": { "type": "string" },
        "auth_env": { "type": "string" },
        "fallback": { "type": "string", "enum": ["cli-engine", "http-inject", "manual-paste", "http-direct", "fail-loud"] },
        "meta": { "type": "object" }
      }
    }
  }
}
