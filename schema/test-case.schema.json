{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/test-case.schema.json",
  "title": "OpsForge test case (7-field, v8 §21.2)",
  "description": "声明式回归用例。additionalProperties:false；input 接受任意类型。",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "input", "expect"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "input": {},
    "expect": {
      "type": "string",
      "enum": ["exact", "schema", "contains", "regex", "llm_judge", "golden", "human"]
    },
    "expected": {},
    "schema_ref": {
      "type": ["string", "null"]
    },
    "judge_rubric": {
      "type": ["string", "null"]
    },
    "judge_threshold": {
      "type": "number",
      "default": 0.7,
      "minimum": 0,
      "maximum": 1
    },
    "weight": {
      "type": "number",
      "default": 1.0,
      "exclusiveMinimum": 0
    },
    "platforms": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "timeout_ms": {
      "type": "integer",
      "default": 30000,
      "minimum": 0
    }
  }
}
