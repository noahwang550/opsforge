{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/workflow.schema.json",
  "title": "OpsForge workflow manifest (§7.1 / §20.1 P1)",
  "description": "线性工作流。P1 control_flow 仅允许 sequence 节点（loop/switch/checkpoint 被 enum 拒绝）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "pack", "owner", "display_name", "display_name_zh", "display_name_en", "description", "platforms", "params_schema", "steps", "tests", "changelog", "source"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}\\.[a-z][a-z0-9-]{2,30}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": { "type": "string", "const": "workflow" },
    "pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "customer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "display_name_zh": { "type": "string", "minLength": 1 },
    "display_name_en": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["claude-code", "cursor", "codex", "cline", "dify", "workbuddy"] }
    },
    "params_schema": { "type": "string", "const": "params.schema.json" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}\\.[a-z][a-z0-9-]{2,30}$" },
          "inputs": { "type": "object" },
          "outputs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "control_flow": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["sequence"] },
          "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "vars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "default": {}
        }
      }
    },
    "kb_mount": { "type": "boolean", "default": false },
    "tests": { "type": "string", "const": "tests/" },
    "changelog": { "type": "string", "const": "CHANGELOG.md" },
    "outputs": { "type": "object" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "type": "string", "enum": ["original", "forked"] },
        "upstream_ref": { "type": ["string", "null"] }
      }
    }
  }
}
