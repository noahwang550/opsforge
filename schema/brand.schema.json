{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/brand.schema.json",
  "title": "OpsForge brand metadata (§5.3, minimal)",
  "description": "客户品牌元数据。Phase 3 完整流。",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand_slug", "display_name", "display_name_zh", "created_at", "contact"],
  "properties": {
    "brand_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "display_name_zh": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "contact": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
