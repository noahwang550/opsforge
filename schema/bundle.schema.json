{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/bundle.schema.json",
  "title": "OpsForge bundle manifest (§3.5)",
  "description": "能力+工作流打包组合。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "pack", "owner", "display_name", "display_name_zh", "display_name_en", "description", "platforms", "capabilities", "tests", "changelog", "source"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}\\.[a-z][a-z0-9-]{2,30}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": { "type": "string", "const": "bundle" },
    "pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "customer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "display_name_zh": { "type": "string", "minLength": 1 },
    "display_name_en": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["claude-code", "cursor", "codex", "cline", "dify"] }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,30}\\.[a-z][a-z0-9-]{2,30}@.+"
      }
    },
    "workflows": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": { "type": "string", "const": "tests/" },
    "changelog": { "type": "string", "const": "CHANGELOG.md" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin"],
      "properties": {
        "origin": { "type": "string", "enum": ["original", "forked"] },
        "upstream_ref": { "type": ["string", "null"] }
      }
    }
  }
}
