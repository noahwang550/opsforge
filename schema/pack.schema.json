{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsforge.dev/schema/pack.schema.json",
  "title": "OpsForge pack metadata (§17, minimal)",
  "description": "贡献者命名空间元数据。Phase 3 完整流。",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "display_name", "display_name_zh", "display_name_en", "owner", "created_at"],
  "properties": {
    "pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "display_name_zh": { "type": "string", "minLength": 1 },
    "display_name_en": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "created_at": { "type": "string", "minLength": 1 },
    "example": { "type": "boolean", "description": "标记为示例/dogfood 包（非核心交付，仅演示业务团队用法）。inventory 据此分流渲染。" }
  }
}
